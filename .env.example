# Copy to .env and fill in real values. Never commit .env.
# Read by docker compose (project root) and by the backend (spring.config.import).

# ---------- Database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aistudy
DB_USERNAME=aistudy
DB_PASSWORD=change-me
# Only used by docker compose to initialize the MySQL container
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- Server ----------
# The backend always listens on 127.0.0.1 (no login in the MVP).
APP_SERVER_PORT=8080

# ---------- File storage ----------
# Relative paths are resolved against the backend working directory.
APP_STORAGE_LOCAL_ROOT=./data/storage

# ---------- AI providers (used from M4) ----------
# Leave a key empty to disable that provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# A multimodal model available to your account
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# Model config ids (see docs/06-ai-provider-architecture.md §10)
AI_DEFAULT_ANALYSIS_MODEL=claude-main
AI_DEFAULT_CHAT_MODEL=claude-main
